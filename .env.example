# OpenAlex asks for a contact email to grant polite-pool access (faster and far
# more reliable than the anonymous pool). It is sent as a query parameter and in
# the User-Agent header. Use your own: never someone else's.
SNOWBIB_MAILTO=you@example.com

# Optional: where your vault lives. Defaults to the current directory.
# SNOWBIB_VAULT=/path/to/vault
